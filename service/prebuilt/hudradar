    }
    start() {
        const ClusterRender = clusterRenderClient().ClusterRender;
        const cr = this.cr = new ClusterRender(CLAIM_ID, CR_SOCKET);
        cr.on('ready', () => {
            log('hud: connected to cluster-render (' + cr.backend + ')');
