        this.cr = null; this.layer = 0; this.geo = null; this.hold = false; this.image = null;
        this.visible = false; this.target = ''; this.holder = ''; this.disabled = false; this.claimTimer = null;
        this.remakeTimer = null; this.remakes = 0;
