        cr.connect();
    }
    _make() {
        const g = this.geo;
        this.layer = this.cr.image({ target: 'hud', klass: 'overlay', x: g.x, y: g.y, w: g.w, h: g.h, iw: OUT_W, ih: OUT_H,
            fps: 30, visible: false, opacity: g.opacity, sampling: 'bilinear' });
